NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Magic-link sign-in and authenticator codes use the URL and anon key above.
# Source copies and staff session revocation use this key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only owner connection for migrations, the compiled-edition import, and public-view reads.
# Do not prefix this with NEXT_PUBLIC_ and do not send it to the browser.
DATABASE_URL=
# Public site key for the corrections and reply forms. The secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Server only. Salt for the public-form IP hash. Never prefix this with NEXT_PUBLIC_.
FORM_IP_SALT=
# Server only. Bearer token for the contact-email purge job and the nightly snapshot.
CRON_SECRET=
# Server only. HTTPS endpoint that receives a notice when the nightly snapshot fails.
# The job does not call it unless CRON_SECRET matches. Never prefix this with NEXT_PUBLIC_.
SNAPSHOT_ALERT_URL=
# Server only. Absolute https origin for sitemap URLs. An empty value leaves the sitemap without a host.
# Setting this does not choose the public domain or close the launch checklist.
SITE_URL=
